{
  "name": "AutoDocumentation",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID"
    },
    "doc_id": {
      "type": "string",
      "description": "Unique documentation identifier"
    },
    "doc_type": {
      "type": "string",
      "enum": [
        "api_endpoint",
        "entity_model",
        "function",
        "component",
        "workflow",
        "integration"
      ],
      "description": "Type of documentation"
    },
    "target_name": {
      "type": "string",
      "description": "Name of the item being documented"
    },
    "target_path": {
      "type": "string",
      "description": "File path or endpoint path"
    },
    "title": {
      "type": "string",
      "description": "Documentation title"
    },
    "summary": {
      "type": "string",
      "description": "AI-generated summary"
    },
    "description": {
      "type": "string",
      "description": "Detailed description"
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          },
          "example": {
            "type": "string"
          }
        }
      },
      "description": "Function/API parameters"
    },
    "returns": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "example": {
          "type": "object"
        }
      },
      "description": "Return value documentation"
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "description": "Code examples"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Dependencies or related components"
    },
    "use_cases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Common use cases"
    },
    "best_practices": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Recommended practices"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Important warnings or gotchas"
    },
    "related_docs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "doc_id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "version": {
      "type": "string",
      "description": "Documentation version"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "generated_by": {
      "type": "string",
      "enum": [
        "ai",
        "manual"
      ],
      "default": "ai"
    },
    "accuracy_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "AI confidence in documentation accuracy"
    },
    "reviewed": {
      "type": "boolean",
      "default": false
    },
    "reviewed_by": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "doc_id",
    "doc_type",
    "target_name",
    "title",
    "summary"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "$ne": null
      }
    },
    "read": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}