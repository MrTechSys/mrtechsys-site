{
  "name": "DataImport",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID"
    },
    "platform": {
      "type": "string",
      "enum": [
        "stripe",
        "square",
        "quickbooks"
      ],
      "description": "Source platform"
    },
    "connected_account_id": {
      "type": "string",
      "description": "Connected account used for import"
    },
    "data_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Types of data imported (customers, invoices, etc.)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "failed"
      ],
      "default": "pending"
    },
    "records_imported": {
      "type": "number",
      "description": "Total records successfully imported"
    },
    "records_skipped": {
      "type": "number",
      "description": "Records skipped (duplicates)"
    },
    "records_failed": {
      "type": "number",
      "description": "Records that failed to import"
    },
    "error_log": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "List of errors encountered"
    },
    "summary": {
      "type": "object",
      "description": "Detailed import summary by type"
    }
  },
  "required": [
    "org_id",
    "platform"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}