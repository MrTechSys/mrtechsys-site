{
  "name": "Role",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Organization ID for multi-tenancy"
    },
    "role_name": {
      "type": "string",
      "description": "Name of the role (e.g., admin, manager, technician)"
    },
    "description": {
      "type": "string",
      "description": "Role description"
    },
    "is_system_role": {
      "type": "boolean",
      "default": false,
      "description": "System roles cannot be deleted or renamed"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Permission keys granted by this role"
    },
    "priority": {
      "type": "number",
      "default": 100,
      "description": "Role priority for conflict resolution (lower = higher priority)"
    }
  },
  "required": [
    "tenant_id",
    "role_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "tenant_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "tenant_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "tenant_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "tenant_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
