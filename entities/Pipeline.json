{
  "name": "Pipeline",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string"
    },
    "project": {
      "type": "string",
      "description": "Project name"
    },
    "repo_url": {
      "type": "string"
    },
    "branches": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tracked branches"
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Pipeline stages"
    },
    "environments": {
      "type": "object",
      "properties": {
        "dev": {
          "type": "object"
        },
        "staging": {
          "type": "object"
        },
        "production": {
          "type": "object"
        }
      }
    },
    "artifact_store": {
      "type": "string"
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string"
          },
          "approvers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "auto_approve": {
            "type": "boolean"
          }
        }
      }
    },
    "notifications": {
      "type": "object",
      "properties": {
        "on_success": {
          "type": "boolean",
          "default": false
        },
        "on_failure": {
          "type": "boolean",
          "default": true
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "org_id",
    "project"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
