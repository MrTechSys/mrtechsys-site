{
  "name": "CustomAlert",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Alert name"
    },
    "description": {
      "type": "string"
    },
    "metric": {
      "type": "string",
      "enum": [
        "req_rate",
        "error_rate",
        "latency_p95",
        "cpu",
        "memory",
        "slo_burn",
        "incident_count",
        "deployment_frequency"
      ],
      "description": "Metric to monitor"
    },
    "condition": {
      "type": "string",
      "enum": [
        "above",
        "below",
        "equals"
      ],
      "description": "Condition type"
    },
    "threshold": {
      "type": "number",
      "description": "Threshold value"
    },
    "duration_minutes": {
      "type": "number",
      "default": 5,
      "description": "Duration threshold must be exceeded"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "critical"
      ],
      "default": "warning"
    },
    "notification_channels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "email",
              "slack",
              "webhook"
            ]
          },
          "target": {
            "type": "string",
            "description": "Email, webhook URL, or slack channel"
          }
        }
      },
      "description": "Where to send alerts"
    },
    "service_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Services to monitor (empty = all)"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "last_triggered": {
      "type": "string",
      "format": "date-time"
    },
    "trigger_count": {
      "type": "number",
      "default": 0
    },
    "created_by": {
      "type": "string"
    }
  },
  "required": [
    "org_id",
    "name",
    "metric",
    "condition",
    "threshold"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}