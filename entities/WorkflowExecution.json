{
  "name": "WorkflowExecution",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string"
    },
    "workflow_id": {
      "type": "string"
    },
    "workflow_name": {
      "type": "string"
    },
    "trigger_data": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "error",
        "running"
      ],
      "default": "running"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "duration_ms": {
      "type": "number"
    }
  },
  "required": [
    "org_id",
    "workflow_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
