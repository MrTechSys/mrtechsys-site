{
  "name": "ConnectedAccount",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID"
    },
    "user_id": {
      "type": "string",
      "description": "User who connected the account"
    },
    "platform": {
      "type": "string",
      "enum": [
        "facebook",
        "nextdoor",
        "instagram",
        "tiktok",
        "zapier"
      ],
      "description": "Social platform name"
    },
    "platform_user_id": {
      "type": "string",
      "description": "External user ID on the platform"
    },
    "platform_username": {
      "type": "string",
      "description": "Display name or username on platform"
    },
    "access_token_encrypted": {
      "type": "string",
      "description": "Encrypted OAuth access token"
    },
    "refresh_token_encrypted": {
      "type": "string",
      "description": "Encrypted OAuth refresh token"
    },
    "token_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the access token expires"
    },
    "scopes_granted": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "OAuth scopes granted by user"
    },
    "last_synced": {
      "type": "string",
      "format": "date-time",
      "description": "Last time leads were pulled from this account"
    },
    "sync_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether auto-sync is enabled"
    },
    "sync_frequency": {
      "type": "string",
      "enum": [
        "hourly",
        "daily",
        "weekly",
        "manual"
      ],
      "default": "daily"
    },
    "filters": {
      "type": "object",
      "description": "Platform-specific filters",
      "properties": {
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "locations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "vertical_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "error",
        "revoked",
        "expired"
      ],
      "default": "active"
    },
    "error_message": {
      "type": "string",
      "description": "Last error encountered during sync"
    }
  },
  "required": [
    "org_id",
    "user_id",
    "platform"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}