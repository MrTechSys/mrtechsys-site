{
  "name": "PerformanceBenchmark",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string"
    },
    "benchmark_id": {
      "type": "string",
      "description": "Unique benchmark identifier"
    },
    "release_id": {
      "type": "string",
      "description": "Release being benchmarked"
    },
    "canary_deployment_id": {
      "type": "string",
      "description": "Associated canary deployment"
    },
    "test_type": {
      "type": "string",
      "enum": [
        "load_test",
        "stress_test",
        "spike_test",
        "endurance_test",
        "baseline"
      ],
      "description": "Type of performance test"
    },
    "environment": {
      "type": "string",
      "enum": [
        "staging",
        "canary",
        "production"
      ],
      "default": "staging"
    },
    "test_config": {
      "type": "object",
      "properties": {
        "virtual_users": {
          "type": "number"
        },
        "duration_seconds": {
          "type": "number"
        },
        "ramp_up_seconds": {
          "type": "number"
        },
        "target_rps": {
          "type": "number"
        }
      },
      "description": "Load test configuration"
    },
    "results": {
      "type": "object",
      "properties": {
        "avg_latency_ms": {
          "type": "number"
        },
        "p50_latency_ms": {
          "type": "number"
        },
        "p95_latency_ms": {
          "type": "number"
        },
        "p99_latency_ms": {
          "type": "number"
        },
        "max_latency_ms": {
          "type": "number"
        },
        "min_latency_ms": {
          "type": "number"
        },
        "total_requests": {
          "type": "number"
        },
        "successful_requests": {
          "type": "number"
        },
        "failed_requests": {
          "type": "number"
        },
        "error_rate": {
          "type": "number"
        },
        "throughput_rps": {
          "type": "number"
        },
        "cpu_avg_pct": {
          "type": "number"
        },
        "memory_avg_mb": {
          "type": "number"
        }
      }
    },
    "ai_analysis": {
      "type": "object",
      "properties": {
        "bottlenecks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "component": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "critical"
                ]
              },
              "description": {
                "type": "string"
              },
              "impact": {
                "type": "string"
              },
              "recommendation": {
                "type": "string"
              },
              "estimated_improvement": {
                "type": "string"
              }
            }
          }
        },
        "scalability_prediction": {
          "type": "object",
          "properties": {
            "max_sustainable_rps": {
              "type": "number"
            },
            "breaking_point_users": {
              "type": "number"
            },
            "scaling_recommendation": {
              "type": "string"
            }
          }
        },
        "comparison_to_baseline": {
          "type": "object",
          "properties": {
            "latency_change_pct": {
              "type": "number"
            },
            "throughput_change_pct": {
              "type": "number"
            },
            "regression_detected": {
              "type": "boolean"
            },
            "improvement_areas": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "production_readiness": {
          "type": "string",
          "enum": [
            "ready",
            "ready_with_concerns",
            "not_ready",
            "needs_optimization"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "slo_compliance": {
      "type": "object",
      "properties": {
        "latency_slo_met": {
          "type": "boolean"
        },
        "error_rate_slo_met": {
          "type": "boolean"
        },
        "availability_slo_met": {
          "type": "boolean"
        }
      }
    },
    "test_scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scenario_name": {
            "type": "string"
          },
          "endpoint": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "avg_latency_ms": {
            "type": "number"
          },
          "success_rate": {
            "type": "number"
          }
        }
      },
      "description": "Individual scenario results"
    },
    "resource_utilization": {
      "type": "object",
      "properties": {
        "cpu_peak_pct": {
          "type": "number"
        },
        "memory_peak_mb": {
          "type": "number"
        },
        "network_in_mb": {
          "type": "number"
        },
        "network_out_mb": {
          "type": "number"
        }
      }
    },
    "issues_found": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issue_type": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "first_seen": {
            "type": "string"
          }
        }
      }
    },
    "passed": {
      "type": "boolean",
      "description": "Whether benchmark passed thresholds"
    }
  },
  "required": [
    "org_id",
    "benchmark_id",
    "test_type",
    "results"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
