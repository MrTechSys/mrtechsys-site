{
  "name": "RateLimitLog",
  "type": "object",
  "properties": {
    "identifier": {
      "type": "string",
      "description": "IP address or user ID"
    },
    "identifier_type": {
      "type": "string",
      "enum": [
        "ip",
        "user",
        "api_key"
      ],
      "description": "Type of identifier"
    },
    "endpoint": {
      "type": "string",
      "description": "API endpoint being rate limited"
    },
    "request_count": {
      "type": "number",
      "description": "Number of requests in window"
    },
    "window_start": {
      "type": "string",
      "format": "date-time",
      "description": "Start of rate limit window"
    },
    "window_end": {
      "type": "string",
      "format": "date-time",
      "description": "End of rate limit window"
    },
    "limit_exceeded": {
      "type": "boolean",
      "default": false
    },
    "blocked_requests": {
      "type": "number",
      "default": 0,
      "description": "Number of blocked requests"
    },
    "last_request_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "identifier",
    "identifier_type",
    "endpoint",
    "request_count"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "$ne": null
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
