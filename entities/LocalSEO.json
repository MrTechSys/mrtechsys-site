{
  "name": "LocalSEO",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID"
    },
    "keyword": {
      "type": "string",
      "description": "Target keyword"
    },
    "search_volume": {
      "type": "number",
      "description": "Monthly search volume"
    },
    "competition": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "current_rank": {
      "type": "number",
      "description": "Current Google ranking position"
    },
    "target_rank": {
      "type": "number",
      "default": 3
    },
    "location": {
      "type": "string",
      "description": "Target location for local search"
    },
    "content_suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "keyword_density": {
            "type": "number"
          }
        }
      }
    },
    "google_business_updates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "update_type": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "posted_at": {
            "type": "string"
          }
        }
      }
    },
    "impressions_30d": {
      "type": "number",
      "default": 0
    },
    "clicks_30d": {
      "type": "number",
      "default": 0
    },
    "last_updated": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "org_id",
    "keyword"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}