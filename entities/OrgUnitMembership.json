{
  "name": "OrgUnitMembership",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Organization ID"
    },
    "unit_id": {
      "type": "string",
      "description": "Organizational unit ID"
    },
    "user_id": {
      "type": "string",
      "description": "User ID"
    },
    "is_manager": {
      "type": "boolean",
      "default": false,
      "description": "True if user manages this OU"
    }
  },
  "required": [
    "tenant_id",
    "unit_id",
    "user_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "tenant_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "tenant_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "tenant_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "tenant_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
