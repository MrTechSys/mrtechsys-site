{
  "name": "CRMActivity",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string"
    },
    "actor_id": {
      "type": "string",
      "description": "User or system that performed action"
    },
    "entity_type": {
      "type": "string",
      "enum": [
        "contact",
        "lead",
        "deal",
        "ticket",
        "quote",
        "invoice"
      ],
      "description": "Type of entity affected"
    },
    "entity_id": {
      "type": "string",
      "description": "ID of affected entity"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "created",
        "updated",
        "deleted",
        "emailed",
        "called",
        "met",
        "viewed",
        "opened",
        "clicked",
        "converted",
        "escalated"
      ],
      "description": "Action performed"
    },
    "metadata": {
      "type": "object",
      "description": "Additional context about the action"
    },
    "ip_address": {
      "type": "string"
    },
    "user_agent": {
      "type": "string"
    }
  },
  "required": [
    "org_id",
    "entity_type",
    "entity_id",
    "action_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}