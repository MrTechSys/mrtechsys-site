{
  "name": "LiveMetric",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string",
      "description": "User session identifier"
    },
    "user_id": {
      "type": "string"
    },
    "page": {
      "type": "string",
      "description": "Current page/route"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "page_view",
        "click",
        "form_submit",
        "api_call",
        "error",
        "custom"
      ],
      "description": "Event type"
    },
    "event_name": {
      "type": "string",
      "description": "Specific event name"
    },
    "properties": {
      "type": "object",
      "description": "Event properties and metadata"
    },
    "value": {
      "type": "number",
      "description": "Numeric value if applicable"
    },
    "duration_ms": {
      "type": "number",
      "description": "Duration in milliseconds"
    },
    "device": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "desktop",
            "mobile",
            "tablet"
          ]
        },
        "os": {
          "type": "string"
        },
        "browser": {
          "type": "string"
        }
      }
    },
    "geo": {
      "type": "object",
      "properties": {
        "country": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "region": {
          "type": "string"
        }
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "org_id",
    "event_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "$ne": null
      }
    },
    "read": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}