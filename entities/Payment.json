{
  "name": "Payment",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string"
    },
    "invoice_id": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "method": {
      "type": "string",
      "enum": [
        "stripe",
        "cash",
        "ach",
        "check",
        "wire"
      ],
      "default": "stripe"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "stripe_payment_intent_id": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "org_id",
    "invoice_id",
    "amount"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
