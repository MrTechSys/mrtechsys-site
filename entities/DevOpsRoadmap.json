{
  "name": "DevOpsRoadmap",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID"
    },
    "name": {
      "type": "string",
      "description": "Roadmap name"
    },
    "description": {
      "type": "string"
    },
    "vision": {
      "type": "string",
      "description": "Strategic vision statement"
    },
    "time_horizon": {
      "type": "string",
      "enum": [
        "quarterly",
        "semi_annual",
        "annual",
        "multi_year"
      ],
      "default": "quarterly",
      "description": "Planning horizon"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "owner_id": {
      "type": "string",
      "description": "Roadmap owner"
    },
    "stakeholders": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User IDs of stakeholders"
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "objective": {
            "type": "string"
          },
          "key_results": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "progress": {
            "type": "number"
          }
        }
      },
      "description": "OKRs (Objectives and Key Results)"
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "performance",
          "security",
          "compliance",
          "scalability",
          "automation",
          "observability",
          "cost_optimization"
        ]
      },
      "description": "Strategic themes"
    },
    "status": {
      "type": "string",
      "enum": [
        "planning",
        "active",
        "on_track",
        "at_risk",
        "blocked",
        "completed"
      ],
      "default": "planning"
    },
    "progress_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "default": 0
    },
    "epic_count": {
      "type": "number",
      "default": 0
    },
    "sprint_count": {
      "type": "number",
      "default": 0
    },
    "is_public": {
      "type": "boolean",
      "default": false,
      "description": "Share with entire org"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "org_id",
    "name",
    "start_date",
    "end_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}