{
  "name": "UserRole",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Organization ID"
    },
    "user_id": {
      "type": "string",
      "description": "User ID"
    },
    "role_id": {
      "type": "string",
      "description": "Role ID"
    },
    "assigned_by": {
      "type": "string",
      "description": "User who assigned this role"
    },
    "assigned_at": {
      "type": "string",
      "format": "date-time",
      "description": "When role was assigned"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Optional expiration date"
    }
  },
  "required": [
    "tenant_id",
    "user_id",
    "role_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "tenant_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "tenant_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "tenant_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "tenant_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
