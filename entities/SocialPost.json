{
  "name": "SocialPost",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID"
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "facebook",
          "instagram",
          "tiktok",
          "linkedin",
          "twitter"
        ]
      },
      "description": "Target platforms"
    },
    "content": {
      "type": "string",
      "description": "Post content/caption"
    },
    "media_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Image or video URLs"
    },
    "hashtags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Hashtags to include"
    },
    "scheduled_for": {
      "type": "string",
      "format": "date-time",
      "description": "When to post"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "posted",
        "failed"
      ],
      "default": "draft"
    },
    "ai_generated": {
      "type": "boolean",
      "default": false
    },
    "post_type": {
      "type": "string",
      "enum": [
        "promotional",
        "educational",
        "behind_the_scenes",
        "testimonial",
        "seasonal"
      ],
      "default": "promotional"
    },
    "engagement": {
      "type": "object",
      "properties": {
        "likes": {
          "type": "number",
          "default": 0
        },
        "comments": {
          "type": "number",
          "default": 0
        },
        "shares": {
          "type": "number",
          "default": 0
        },
        "reach": {
          "type": "number",
          "default": 0
        }
      }
    },
    "posted_at": {
      "type": "string",
      "format": "date-time"
    },
    "posted_ids": {
      "type": "object",
      "description": "Platform-specific post IDs"
    },
    "error_message": {
      "type": "string"
    }
  },
  "required": [
    "org_id",
    "content"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
