{
  "name": "TeamChannel",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "public",
        "private",
        "dm",
        "group"
      ],
      "default": "public"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User IDs"
    },
    "admins": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_archived": {
      "type": "boolean",
      "default": false
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time"
    },
    "unread_count": {
      "type": "object",
      "description": "Per-user unread counts"
    }
  },
  "required": [
    "org_id",
    "name",
    "type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}",
          "members": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "admins": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "admins": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
