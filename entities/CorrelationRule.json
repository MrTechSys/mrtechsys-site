{
  "name": "CorrelationRule",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID"
    },
    "rule_id": {
      "type": "string",
      "description": "Unique correlation rule ID"
    },
    "name": {
      "type": "string",
      "description": "Rule name"
    },
    "description": {
      "type": "string"
    },
    "event_pattern": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "event_type": {
            "type": "string"
          },
          "conditions": {
            "type": "object"
          },
          "time_window_seconds": {
            "type": "number"
          }
        }
      },
      "description": "Sequence of events to correlate"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "threshold": {
      "type": "object",
      "description": "Threshold configuration",
      "properties": {
        "occurrences": {
          "type": "number",
          "description": "How many times pattern must occur"
        },
        "time_window_minutes": {
          "type": "number",
          "description": "Time window for correlation"
        },
        "unique_sources": {
          "type": "number",
          "description": "Minimum unique sources required"
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action_type": {
            "type": "string",
            "enum": [
              "create_alert",
              "execute_playbook",
              "notify_team",
              "block_ip",
              "create_incident"
            ]
          },
          "parameters": {
            "type": "object"
          }
        }
      },
      "description": "Actions to take when rule triggers"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "match_count": {
      "type": "number",
      "default": 0
    },
    "last_matched_at": {
      "type": "string",
      "format": "date-time"
    },
    "false_positive_count": {
      "type": "number",
      "default": 0
    },
    "accuracy_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Rule accuracy (1 - false_positive_rate)"
    },
    "created_by": {
      "type": "string"
    }
  },
  "required": [
    "org_id",
    "rule_id",
    "name",
    "event_pattern",
    "threshold"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}