{
  "name": "ContentAsset",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID"
    },
    "asset_type": {
      "type": "string",
      "enum": [
        "email",
        "social_post",
        "proposal",
        "marketing_copy",
        "blog_post",
        "case_study"
      ],
      "default": "email",
      "description": "Type of content generated"
    },
    "title": {
      "type": "string",
      "description": "Asset title"
    },
    "content": {
      "type": "string",
      "description": "Generated content body"
    },
    "lead_id": {
      "type": "string",
      "description": "Associated lead if applicable"
    },
    "deal_id": {
      "type": "string",
      "description": "Associated deal if applicable"
    },
    "campaign_id": {
      "type": "string",
      "description": "Marketing campaign ID"
    },
    "tone": {
      "type": "string",
      "enum": [
        "professional",
        "casual",
        "friendly",
        "urgent",
        "technical"
      ],
      "default": "professional"
    },
    "target_audience": {
      "type": "string",
      "description": "Intended audience"
    },
    "ai_generated": {
      "type": "boolean",
      "default": true
    },
    "generation_prompt": {
      "type": "string",
      "description": "Prompt used for AI generation"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "reviewed",
        "published",
        "archived"
      ],
      "default": "draft"
    },
    "performance_metrics": {
      "type": "object",
      "properties": {
        "views": {
          "type": "number"
        },
        "clicks": {
          "type": "number"
        },
        "conversions": {
          "type": "number"
        },
        "engagement_rate": {
          "type": "number"
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "org_id",
    "asset_type",
    "title",
    "content"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}