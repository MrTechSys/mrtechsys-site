{
  "name": "AlertWorkflow",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID"
    },
    "workflow_id": {
      "type": "string",
      "description": "Unique workflow identifier"
    },
    "name": {
      "type": "string",
      "description": "Workflow name"
    },
    "description": {
      "type": "string"
    },
    "trigger_conditions": {
      "type": "object",
      "description": "When to trigger this workflow",
      "properties": {
        "alert_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "severity_threshold": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "entity_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "notification_channels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "channel_type": {
            "type": "string",
            "enum": [
              "slack",
              "teams",
              "pagerduty",
              "email",
              "sms",
              "webhook"
            ]
          },
          "config": {
            "type": "object",
            "properties": {
              "webhook_url": {
                "type": "string"
              },
              "channel_id": {
                "type": "string"
              },
              "recipients": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "integration_key": {
                "type": "string"
              }
            }
          },
          "enabled": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "description": "Alert notification channels"
    },
    "escalation_policy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "escalate_after_minutes": {
          "type": "number",
          "default": 30
        },
        "escalate_to_channels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "escalate_to_users": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "execution_count": {
      "type": "number",
      "default": 0
    },
    "success_count": {
      "type": "number",
      "default": 0
    },
    "last_executed_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string"
    }
  },
  "required": [
    "org_id",
    "workflow_id",
    "name",
    "trigger_conditions",
    "notification_channels"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}