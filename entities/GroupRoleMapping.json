{
  "name": "GroupRoleMapping",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Organization ID"
    },
    "group_id": {
      "type": "string",
      "description": "Group ID"
    },
    "role_id": {
      "type": "string",
      "description": "Role ID"
    },
    "assigned_by": {
      "type": "string",
      "description": "User who created this mapping"
    }
  },
  "required": [
    "tenant_id",
    "group_id",
    "role_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "tenant_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "tenant_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "tenant_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "tenant_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}