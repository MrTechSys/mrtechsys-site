{
  "name": "SecurityAlert",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string"
    },
    "alert_id": {
      "type": "string",
      "description": "Unique alert identifier"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "alert_type": {
      "type": "string",
      "enum": [
        "suspicious_activity",
        "rate_limit_exceeded",
        "unauthorized_access",
        "attack_detected",
        "policy_violation",
        "anomaly_detected",
        "compliance_breach",
        "data_exposure"
      ],
      "description": "Type of security alert"
    },
    "title": {
      "type": "string",
      "description": "Alert title"
    },
    "description": {
      "type": "string",
      "description": "Detailed alert description"
    },
    "threat_actor": {
      "type": "object",
      "properties": {
        "ip_address": {
          "type": "string"
        },
        "user_id": {
          "type": "string"
        },
        "user_agent": {
          "type": "string"
        },
        "location": {
          "type": "string"
        }
      },
      "description": "Information about threat source"
    },
    "affected_resources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Endpoints or entities affected"
    },
    "risk_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Calculated risk score"
    },
    "risk_factors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Contributing risk factors"
    },
    "suggested_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string"
          },
          "priority": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "automated": {
            "type": "boolean"
          }
        }
      },
      "description": "Recommended remediation steps"
    },
    "auto_actions_taken": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          },
          "result": {
            "type": "string"
          }
        }
      },
      "description": "Automated actions already executed"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "investigating",
        "resolved",
        "false_positive"
      ],
      "default": "active"
    },
    "assigned_to": {
      "type": "string",
      "description": "User ID responsible for investigation"
    },
    "notified_users": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Users who received notifications"
    },
    "notification_channels": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "email",
          "slack",
          "teams",
          "pagerduty",
          "sms",
          "in_app"
        ]
      }
    },
    "related_incident_id": {
      "type": "string",
      "description": "Related security incident if escalated"
    },
    "detected_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolution_notes": {
      "type": "string"
    },
    "false_positive": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "org_id",
    "alert_id",
    "severity",
    "alert_type",
    "title",
    "description"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "$ne": null
      }
    },
    "read": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
