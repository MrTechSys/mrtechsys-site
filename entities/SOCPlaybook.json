{
  "name": "SOCPlaybook",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Organization ID (null for global playbooks)"
    },
    "playbook_id": {
      "type": "string",
      "description": "Unique playbook identifier"
    },
    "name": {
      "type": "string",
      "description": "Playbook name"
    },
    "description": {
      "type": "string",
      "description": "What this playbook does"
    },
    "trigger_condition": {
      "type": "object",
      "properties": {
        "event_type": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "severity_threshold": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "risk_score_threshold": {
          "type": "number"
        },
        "pattern": {
          "type": "string",
          "description": "Pattern matching expression"
        }
      },
      "description": "Conditions that trigger this playbook"
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action_type": {
            "type": "string",
            "enum": [
              "throttle_user",
              "lock_user",
              "revoke_tokens",
              "require_mfa",
              "notify_admin",
              "quarantine_session",
              "freeze_tenant",
              "disable_agent",
              "escalate_alert",
              "log_forensics"
            ]
          },
          "parameters": {
            "type": "object"
          },
          "delay_seconds": {
            "type": "number",
            "default": 0
          }
        }
      },
      "description": "Actions to execute when triggered"
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether playbook is active"
    },
    "is_system_playbook": {
      "type": "boolean",
      "default": false,
      "description": "System playbooks cannot be deleted"
    },
    "execution_count": {
      "type": "number",
      "default": 0,
      "description": "Number of times executed"
    },
    "last_executed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last execution time"
    },
    "success_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Success rate of executions"
    },
    "requires_human_approval": {
      "type": "boolean",
      "default": false,
      "description": "Whether actions require human approval before execution"
    }
  },
  "required": [
    "playbook_id",
    "name",
    "trigger_condition",
    "actions"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "tenant_id": "{{user.data.current_org_id}}"
        },
        {
          "tenant_id": null
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$and": [
        {
          "is_system_playbook": false
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
