{
  "name": "LeadScoringConfig",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID"
    },
    "weights": {
      "type": "object",
      "properties": {
        "company_size": {
          "type": "number",
          "default": 0.25,
          "minimum": 0,
          "maximum": 1
        },
        "technographics": {
          "type": "number",
          "default": 0.25,
          "minimum": 0,
          "maximum": 1
        },
        "engagement": {
          "type": "number",
          "default": 0.25,
          "minimum": 0,
          "maximum": 1
        },
        "intent": {
          "type": "number",
          "default": 0.25,
          "minimum": 0,
          "maximum": 1
        }
      },
      "description": "Relative weights for scoring factors (sum is recommended to be 1.0)"
    },
    "caps": {
      "type": "object",
      "properties": {
        "max_score": {
          "type": "number",
          "default": 100
        },
        "min_score": {
          "type": "number",
          "default": 0
        }
      }
    },
    "source_prefs": {
      "type": "object",
      "properties": {
        "salesforce": {
          "type": "boolean",
          "default": true
        },
        "hubspot": {
          "type": "boolean",
          "default": true
        },
        "web": {
          "type": "boolean",
          "default": true
        },
        "social": {
          "type": "boolean",
          "default": false
        }
      },
      "description": "Toggle which sources to include during scoring/enrichment"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "org_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}