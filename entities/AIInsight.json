{
  "name": "AIInsight",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string"
    },
    "entity_type": {
      "type": "string",
      "enum": [
        "lead",
        "deal",
        "contact"
      ]
    },
    "entity_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "next_action",
        "deal_prediction",
        "summary"
      ]
    },
    "content": {
      "type": "string"
    },
    "score": {
      "type": "number"
    },
    "confidence": {
      "type": "number"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "org_id",
    "entity_type",
    "entity_id",
    "type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}