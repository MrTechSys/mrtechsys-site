{
  "name": "APIToken",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Owning tenant ID"
    },
    "user_id": {
      "type": "string",
      "description": "User who created the token"
    },
    "client_id": {
      "type": "string",
      "description": "Associated connected app (if any)"
    },
    "token_hash": {
      "type": "string",
      "description": "Hashed JWT token ID"
    },
    "token_type": {
      "type": "string",
      "enum": [
        "access",
        "refresh",
        "api_key",
        "webhook"
      ],
      "default": "access"
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Granted permission scopes"
    },
    "plan_tier": {
      "type": "string",
      "enum": [
        "free",
        "starter",
        "pro",
        "partner",
        "elite"
      ],
      "default": "free"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_used_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked": {
      "type": "boolean",
      "default": false
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_reason": {
      "type": "string"
    },
    "ip_whitelist": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Allowed IP addresses"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "tenant_id",
    "token_hash",
    "token_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "tenant_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "tenant_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "tenant_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}