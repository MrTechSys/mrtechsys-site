{
  "name": "SystemConfiguration",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID"
    },
    "config_key": {
      "type": "string",
      "description": "Configuration key (unique per org)"
    },
    "config_value": {
      "type": "object",
      "description": "Configuration value (flexible JSON)"
    },
    "category": {
      "type": "string",
      "enum": [
        "system",
        "integration",
        "notification",
        "security",
        "billing",
        "feature"
      ],
      "default": "system"
    },
    "is_sensitive": {
      "type": "boolean",
      "default": false,
      "description": "Whether this config contains sensitive data"
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "org_id",
    "config_key",
    "config_value"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
