{
  "name": "StorefrontSettings",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string"
    },
    "logo": {
      "type": "string"
    },
    "colors": {
      "type": "object",
      "properties": {
        "primary": {
          "type": "string"
        },
        "secondary": {
          "type": "string"
        }
      }
    },
    "home_page_id": {
      "type": "string"
    },
    "custom_domain": {
      "type": "string"
    },
    "published": {
      "type": "boolean",
      "default": false
    },
    "feature_flags": {
      "type": "object",
      "properties": {
        "storefront_custom_domain": {
          "type": "boolean",
          "default": false
        }
      }
    }
  },
  "required": [
    "org_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "$ne": null
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
