{
  "name": "AISuggestion",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "context": {
      "type": "object",
      "properties": {
        "module": {
          "type": "string"
        },
        "entity": {
          "type": "string"
        },
        "intent": {
          "type": "string"
        }
      }
    },
    "query": {
      "type": "string"
    },
    "response": {
      "type": "string"
    },
    "rating": {
      "type": "string",
      "enum": [
        "positive",
        "negative"
      ]
    },
    "feedback": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "query",
    "response"
  ],
  "rls": {
    "create": {
      "user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_id": "{{user.id}}"
    },
    "delete": {
      "user_id": "{{user.id}}"
    }
  }
}