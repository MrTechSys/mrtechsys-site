{
  "name": "CanaryDeployment",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string"
    },
    "deployment_id": {
      "type": "string",
      "description": "Unique deployment identifier"
    },
    "release_id": {
      "type": "string",
      "description": "Associated Release ID"
    },
    "pipeline_run_id": {
      "type": "string"
    },
    "canary_version": {
      "type": "string",
      "description": "Version being tested"
    },
    "baseline_version": {
      "type": "string",
      "description": "Current production version"
    },
    "traffic_split": {
      "type": "object",
      "properties": {
        "canary_pct": {
          "type": "number",
          "description": "Percentage of traffic to canary"
        },
        "baseline_pct": {
          "type": "number",
          "description": "Percentage to baseline"
        }
      },
      "description": "Traffic distribution"
    },
    "status": {
      "type": "string",
      "enum": [
        "initializing",
        "running",
        "analyzing",
        "passed",
        "failed",
        "rolled_back",
        "promoted"
      ],
      "default": "initializing"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_minutes": {
      "type": "number",
      "description": "Total canary duration"
    },
    "performance_metrics": {
      "type": "object",
      "properties": {
        "canary": {
          "type": "object",
          "properties": {
            "avg_latency_ms": {
              "type": "number"
            },
            "p95_latency_ms": {
              "type": "number"
            },
            "p99_latency_ms": {
              "type": "number"
            },
            "error_rate": {
              "type": "number"
            },
            "request_count": {
              "type": "number"
            }
          }
        },
        "baseline": {
          "type": "object",
          "properties": {
            "avg_latency_ms": {
              "type": "number"
            },
            "p95_latency_ms": {
              "type": "number"
            },
            "p99_latency_ms": {
              "type": "number"
            },
            "error_rate": {
              "type": "number"
            },
            "request_count": {
              "type": "number"
            }
          }
        },
        "comparison": {
          "type": "object",
          "properties": {
            "latency_delta_pct": {
              "type": "number"
            },
            "error_rate_delta_pct": {
              "type": "number"
            },
            "meets_slo": {
              "type": "boolean"
            }
          }
        }
      },
      "description": "Performance comparison"
    },
    "ai_analysis": {
      "type": "object",
      "properties": {
        "bottlenecks_detected": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "location": {
                "type": "string"
              },
              "severity": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "recommendation": {
                "type": "string"
              }
            }
          }
        },
        "performance_prediction": {
          "type": "object",
          "properties": {
            "expected_latency_under_load": {
              "type": "number"
            },
            "scalability_score": {
              "type": "number"
            },
            "risk_assessment": {
              "type": "string"
            }
          }
        },
        "recommendation": {
          "type": "string",
          "enum": [
            "promote",
            "rollback",
            "continue_monitoring",
            "investigate"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "health_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string"
          },
          "canary_healthy": {
            "type": "boolean"
          },
          "baseline_healthy": {
            "type": "boolean"
          },
          "details": {
            "type": "string"
          }
        }
      }
    },
    "decision": {
      "type": "string",
      "enum": [
        "promote_to_production",
        "rollback",
        "continue_monitoring"
      ],
      "description": "Final deployment decision"
    },
    "decision_reason": {
      "type": "string"
    },
    "promoted_at": {
      "type": "string",
      "format": "date-time"
    },
    "rolled_back_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "org_id",
    "deployment_id",
    "canary_version",
    "baseline_version"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}