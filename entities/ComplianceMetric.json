{
  "name": "ComplianceMetric",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string"
    },
    "metric_type": {
      "type": "string",
      "enum": [
        "failed_logins_7d",
        "failed_logins_30d",
        "rbac_changes",
        "audit_events",
        "mfa_adoption",
        "uptime",
        "security_controls",
        "privacy_requests"
      ],
      "description": "Type of metric"
    },
    "value": {
      "type": "number",
      "description": "Metric value"
    },
    "status": {
      "type": "string",
      "enum": [
        "normal",
        "warning",
        "critical"
      ],
      "default": "normal"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "org_id",
    "metric_type",
    "value"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}