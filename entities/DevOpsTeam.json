{
  "name": "DevOpsTeam",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID"
    },
    "name": {
      "type": "string",
      "description": "Team name"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "lead",
              "engineer",
              "analyst",
              "viewer"
            ]
          }
        }
      },
      "description": "Team members with roles"
    },
    "channels": {
      "type": "object",
      "properties": {
        "slack_webhook": {
          "type": "string"
        },
        "email_list": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pagerduty_key": {
          "type": "string"
        }
      }
    },
    "runbooks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "required": [
    "org_id",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}