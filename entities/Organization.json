{
  "name": "Organization",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Organization name"
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly identifier"
    },
    "owner_id": {
      "type": "string",
      "description": "User ID of organization owner"
    },
    "industry": {
      "type": "string",
      "description": "Business industry/vertical"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "deleted"
      ],
      "default": "active"
    },
    "webhook_secret": {
      "type": "string",
      "description": "Unique secret for webhook authentication"
    },
    "settings": {
      "type": "object",
      "description": "Organization settings",
      "properties": {
        "brand_name": {
          "type": "string"
        },
        "tagline": {
          "type": "string"
        },
        "logo_url": {
          "type": "string"
        },
        "primary_color": {
          "type": "string",
          "default": "#3b82f6"
        },
        "secondary_color": {
          "type": "string",
          "default": "#8b5cf6"
        },
        "reply_email": {
          "type": "string"
        },
        "sms_from": {
          "type": "string"
        },
        "timezone": {
          "type": "string",
          "default": "America/Chicago"
        },
        "currency": {
          "type": "string",
          "default": "USD"
        },
        "tax_default": {
          "type": "number",
          "default": 0
        },
        "comms_opt_in": {
          "type": "boolean",
          "default": false
        },
        "analytics_opt_in": {
          "type": "boolean",
          "default": false
        },
        "agents_enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable AI agents"
        },
        "emotion_ai_enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable emotion AI"
        },
        "micro_moments_enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable predictive triggers"
        },
        "auto_escalate_threshold": {
          "type": "number",
          "default": -0.5,
          "description": "Sentiment threshold for auto-escalation"
        }
      }
    }
  },
  "required": [
    "name",
    "owner_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "owner_id": "{{user.id}}"
        },
        {
          "id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "owner_id": "{{user.id}}"
        },
        {
          "id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
