{
  "name": "QuoteVersion",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string"
    },
    "quote_id": {
      "type": "string",
      "description": "Reference to parent quote"
    },
    "version_number": {
      "type": "number"
    },
    "changes_description": {
      "type": "string"
    },
    "before_snapshot": {
      "type": "object",
      "description": "State before change"
    },
    "after_snapshot": {
      "type": "object",
      "description": "State after change"
    },
    "actor_id": {
      "type": "string"
    }
  },
  "required": [
    "org_id",
    "quote_id",
    "version_number"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
