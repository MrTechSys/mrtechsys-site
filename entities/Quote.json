{
  "name": "Quote",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "lead_id": {
      "type": "string"
    },
    "number": {
      "type": "string",
      "description": "Quote number (e.g., Q-2024-001)"
    },
    "items": {
      "type": "array",
      "description": "Line items",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "tax_rate": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "tax": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "viewed",
        "accepted",
        "rejected",
        "expired"
      ],
      "default": "draft"
    },
    "valid_until": {
      "type": "string",
      "format": "date"
    },
    "pdf_url": {
      "type": "string"
    },
    "public_hash": {
      "type": "string",
      "description": "Public access token"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "org_id",
    "client_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "data.org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
