{
  "name": "ReportSchedule",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string"
    },
    "report_id": {
      "type": "string"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "monthly",
        "custom"
      ]
    },
    "cron_expression": {
      "type": "string",
      "description": "Custom cron expression for advanced scheduling"
    },
    "recipients": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_run": {
      "type": "string",
      "format": "date-time"
    },
    "last_run": {
      "type": "string",
      "format": "date-time"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "org_id",
    "report_id",
    "frequency"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
