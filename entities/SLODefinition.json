{
  "name": "SLODefinition",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string"
    },
    "slo_id": {
      "type": "string"
    },
    "service_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "indicator": {
      "type": "string",
      "enum": [
        "availability",
        "latency_p95",
        "latency_p99",
        "error_rate"
      ],
      "description": "SLI type"
    },
    "target": {
      "type": "number",
      "description": "Target percentage (99.9 for 99.9%)"
    },
    "window_days": {
      "type": "number",
      "default": 30
    },
    "budget_pct": {
      "type": "number",
      "description": "Error budget percentage"
    },
    "description": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "org_id",
    "slo_id",
    "service_id",
    "indicator",
    "target"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "org_id": "{{user.data.current_org_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
